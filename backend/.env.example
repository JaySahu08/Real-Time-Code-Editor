# =============================================================
# Real-Time Collaborative Code Editor — environment template
# =============================================================
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env
# =============================================================

# ---- PostgreSQL (used by docker-compose and the backend) ----
POSTGRES_DB=rce
POSTGRES_USER=rce
POSTGRES_PASSWORD=change-me-in-real-env

# ---- Backend ----
# Inside Docker, the host is the compose service name "postgres".
# For running the backend on your host against a containerized DB,
# use localhost instead.
DB_URL=jdbc:postgresql://postgres:5432/rce
DB_USER=rce
DB_PASSWORD=change-me-in-real-env

SERVER_PORT=8080

# ---- JWT ----
# MUST be at least 32 bytes UTF-8. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-real-32-byte-minimum-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Limits ----
MAX_FILE_CONTENT_BYTES=524288
MAX_CHAT_MESSAGE_CHARS=4000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080